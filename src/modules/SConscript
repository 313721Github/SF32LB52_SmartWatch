import os
import subprocess
from building import *

cwd = GetCurrentDir()
src = Glob('*.c')       # 扫描当前文件夹下所有的 .c 文件
inc = [cwd]             # 把当前文件夹加入头文件搜索路径

project_root = os.path.abspath(os.path.join(cwd, '..', '..'))
cppdefines = []

try:
    project_hash = subprocess.check_output(
        ['git', '-C', project_root, 'rev-parse', '--short=8', 'HEAD'],
        text=True
    ).strip()

    worktree_state = subprocess.check_output(
        ['git', '-C', project_root, 'status', '--porcelain'],
        text=True
    ).strip()

    cppdefines.append('SMARTWATCH_GIT_HASH=' + project_hash)

    if worktree_state:
        cppdefines.append('SMARTWATCH_GIT_DIRTY=1')

except Exception:
    cppdefines.append('SMARTWATCH_GIT_HASH=unknown')


# 向上一级汇报自己的工作成果
group = DefineGroup('app_submodule', src, depend = [''], CPPPATH = inc,CPPDEFINES=cppdefines)
Return('group')